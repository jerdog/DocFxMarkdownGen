<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Packaging Information -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dfmg</ToolCommandName>
    <PackageId>DocFxMarkdownGen</PackageId>
    <Description>Generates documentation for a .NET library in Markdown intended for Docusaurus using docfx.</Description>
    <PackageTags>docfx docusaurus markdown generator documentation</PackageTags>
    <Authors>Jan0660</Authors>
    <PackageProjectUrl>https://github.com/Jan0660/DocFxMarkdownGen</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Jan0660/DocFxMarkdownGen</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Log73" Version="1.0.0" />
    <PackageReference Include="YamlDotNet" Version="15.1.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="docfx_src/**" />
    <EmbeddedResource Remove="docfx_src/**" />
    <None Remove="docfx_src/**" />
    <Compile Remove="examples/**" />
    <EmbeddedResource Remove="examples/**" />
    <None Remove="examples/**" />
    <Compile Remove="_site/**" />
    <EmbeddedResource Remove="_site/**" />
    <None Remove="_site/**" />
  </ItemGroup>

</Project>
